# Reference only — do NOT copy this to .env.
#
# Local development uses Doppler, not a .env file. From the repo root:
#
#   doppler login
#   cd apps/web && doppler setup --no-interactive   # reads doppler.yaml
#   pnpm dev:doppler
#
# This file documents what each variable is and why, which Doppler's UI does not.
# Creating a .env from it still "works" — Next.js loads it — but that value then
# silently diverges from Doppler for everyone else. Add the variable to Doppler
# instead:
#
#   doppler secrets set MY_VAR --project temple-era-web --config dev
#
# When adding environment variables, update the schema in /src/env.js accordingly,
# add them here for documentation, and set them in all three Doppler configs
# (dev, stg, prd).
#
# NOTE: apps/bot is NOT on Doppler — it still uses apps/bot/.env. See apps/bot/env.example.

# Authentication
AUTH_SECRET="your_auth_secret_here"    # Generate: npx auth secret
AUTH_DISCORD_ID="your_discord_client_id"
AUTH_DISCORD_SECRET="your_discord_client_secret"

# Database
# DATABASE_URL (port 6543) is Supavisor's transaction-mode pooler — use it for app runtime traffic.
# DATABASE_MIGRATION_URL (port 5432) is the session-mode pooler — use it for schema operations
# (db:push/db:generate/db:migrate, db:clone-prod). Transaction-mode pooling multiplexes many
# clients onto shared backend processes and doesn't reliably propagate session state like
# search_path, so a pooled backend left with search_path='' (e.g. by pg_restore during
# db:clone-prod, which sets it on its own connection for safety) can be handed to the next
# client and break unqualified DDL with "no schema has been selected to create in".
DATABASE_URL="postgresql://username:password@hostname:6543/database"
DATABASE_MIGRATION_URL="postgresql://username:password@hostname:5432/database"

# WarcraftLogs
WCL_OAUTH_URL="https://vanilla.warcraftlogs.com/oauth/token"
WCL_API_URL="https://vanilla.warcraftlogs.com/api/v2/client"
WCL_CLIENT_ID="your_wcl_client_id"
WCL_CLIENT_SECRET="your_wcl_client_secret"

# Battle.net
BATTLENET_OAUTH_URL="https://oauth.battle.net/token"
BATTLENET_CLIENT_ID="your_battlenet_client_id"
BATTLENET_CLIENT_SECRET="your_battlenet_client_secret"

# Discord
DISCORD_SERVER_ID="your_discord_server_id"

# Break-glass superadmins: comma-separated Discord user IDs granted every scope.
# Resolved from env rather than the DB, so this access cannot be revoked through the admin UI.
# Optional — leave empty to disable.
SUPERADMIN_DISCORD_IDS=""
DISCORD_BOT_TOKEN="your_discord_bot_token"
DISCORD_RAID_LOGS_CHANNEL_ID="your_channel_id"
DISCORD_RAID_SR_CHANNEL_IDS="channel_id_1,channel_id_2,channel_id_3"
DISCORD_WEBHOOK_PUBLIC_KEY="your_webhook_public_key"
TEMPLE_WEB_API_TOKEN="your_api_token"

# Raid Helper
DISCORD_RAID_HELPER_BOT_ID="579155972115660803"
RAID_HELPER_API_KEY="your_raid_helper_api_key"
DISCORD_RAID_HELPER_ARCHIVE_CHANNEL_ID=""    # Optional: excludes this channel from fetchScheduledEvents() (e.g. an #rh-signup-archive channel)

# Security
API_TOKEN_ENCRYPTION_KEY=""    # Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QSTASH_TOKEN=""    # Upstash QStash — schedules the Raid Helper signup snapshot discovery poll + per-checkpoint captures
QSTASH_CURRENT_SIGNING_KEY=""    # Verifies inbound QStash webhook signatures
QSTASH_NEXT_SIGNING_KEY=""    # Second signing key for QStash's key-rotation window

# Analytics (optional)
NEXT_PUBLIC_POSTHOG_ENABLED="false"
NEXT_PUBLIC_POSTHOG_KEY="your_posthog_key"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.co"

# App (optional)
NEXT_PUBLIC_APP_URL="https://your-app-url.com"
NEXT_PUBLIC_RESTRICTED_NAXX_ITEMS_URL="https://docs.google.com/spreadsheets/d/1OBcFgT1AXiPL3eW7x3yUx6EjsopPLlFMclph2OGRkXU/edit"
NEXT_PUBLIC_RAID_POLICY_URL="https://discord.com/channels/1132586324264759390/1467931414048669981/1467957876818579737"
GOOGLE_SITE_VERIFICATION="your_google_site_verification_token"

# Development
DATABASE_PROD_URL="postgresql://username:password@hostname:6543/database"
