    "lucide-react": "^1.28.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "^0.4.6",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "posthog-js": "^1.409.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "superjson": "^2.2.6",
