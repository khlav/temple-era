    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "ct3aMetadata": {
    "initVersion": "7.38.1"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
