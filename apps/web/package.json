{
  "name": "temple-era-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "db:clone-prod": "bash scripts/db/clone-prod.sh",
    "db:clone-prod:doppler": "doppler run -- bash scripts/db/clone-prod.sh",
    "db:deploy": "drizzle-kit migrate && node scripts/db/kill-idle-connections.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migration:compare": "bash scripts/db/compare-row-counts.sh",
    "db:migration:dump:data": "bash scripts/db/dump.sh data-only",
    "db:migration:dump:full": "bash scripts/db/dump.sh full",
    "db:migration:preflight": "bash scripts/db/preflight.sh",
    "db:migration:restore": "bash scripts/db/restore.sh",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:studio:doppler": "doppler run -- drizzle-kit studio",
    "dev": "next dev",
    "dev:doppler": "doppler run -- next dev",
    "dev:standard": "next dev --webpack",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt src/",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "preview": "next build && next start",
    "qstash:setup-discovery-schedule": "node scripts/qstash/setup-discovery-schedule.mjs",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
