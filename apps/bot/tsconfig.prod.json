{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true
  },
  /* Tests are excluded from the production EMIT only. tsconfig.json still includes them, so
     `pnpm typecheck` covers them; without this they would be compiled into dist/ and shipped
     in the Docker image, which does not install vitest. */
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.test.ts"]
}

