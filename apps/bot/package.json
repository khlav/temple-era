{
  "name": "temple-era-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Discord bot for Temple Raids WCL link detection and raid creation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "dev": "doppler run -- tsx watch src/index.ts",
    "dev:env": "tsx watch src/index.ts",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt src/",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "warcraft-logs",
    "raid-tracking"
  ],
  "author": "Temple Ashkandi",
  "license": "MIT",
  "dependencies": {
    "@temple-era/contracts": "workspace:*",
    "@temple-era/wcl": "workspace:*",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.6.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.76.0",
    "tsx": "^4.23.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
