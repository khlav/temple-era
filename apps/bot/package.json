{
  "name": "temple-era-bot",
  "version": "1.0.0",
  "type": "module",
  "description": "Discord bot for Temple Raids WCL link detection and raid creation",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.prod.json",
    "dev": "doppler run -- tsx watch src/index.ts",
    "dev:env": "tsx watch src/index.ts",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt src/",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "warcraft-logs",
    "raid-tracking"
  ],
  "author": "Temple Ashkandi",
  "license": "MIT",
  "dependencies": {
    "@temple-era/contracts": "workspace:*",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "node-cron": "^4.2.1",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
