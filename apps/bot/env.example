# Discord Bot Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_RAID_LOGS_CHANNEL_ID=your_channel_id_here

# SoftRes Automation Configuration
DISCORD_RAID_SR_CHANNEL_IDS=your_comma_separated_channel_ids_here
DISCORD_RAID_HELPER_BOT_ID=raid_helper_bot_user_id_here
DISCORD_SOFTRES_TOKEN_THREAD_ID=your_softres_token_thread_id_here
DISCORD_SERVER_ID=your_discord_server_id_here

# Temple Ashkandi API Configuration
API_BASE_URL=https://www.templeashkandi.com
TEMPLE_WEB_API_TOKEN=your_generated_token_here

# Logging Configuration (optional)
LOG_LEVEL=info

# Thread Cleanup Configuration (optional - disabled by default)
DISCORD_LOG_THREAD_CLEANUP_ENABLED=false
DISCORD_LOG_THREAD_CLEANUP_DAYS=3
DISCORD_LOG_THREAD_CLEANUP_CRON="0 1 * * *"
