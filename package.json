{
  "name": "temple-era",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Temple Raids monorepo — Next.js web app (temple-era.com) and Discord bot",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
