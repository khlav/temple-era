{
  "name": "temple-era",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Temple Raids monorepo — Next.js web app (temple-era.com) and Discord bot",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run format",
    "format:fix": "turbo run format:fix",
    "test": "turbo run test",
    "prepare": "lefthook install",
    "dev": "pnpm --filter temple-era-web dev",
    "dev:web": "pnpm --filter temple-era-web dev",
    "dev:bot": "pnpm --filter temple-era-bot dev",
    "dev:all": "turbo run dev",
    "web": "pnpm --filter temple-era-web",
    "bot": "pnpm --filter temple-era-bot",
    "db:generate": "pnpm --filter temple-era-web db:generate",
    "db:migrate": "pnpm --filter temple-era-web db:migrate",
    "db:deploy": "pnpm --filter temple-era-web db:deploy",
    "db:push": "pnpm --filter temple-era-web db:push",
    "db:studio": "pnpm --filter temple-era-web db:studio",
    "db:clone-prod": "pnpm --filter temple-era-web db:clone-prod",
    "db:migration:compare": "pnpm --filter temple-era-web db:migration:compare",
    "db:migration:dump:data": "pnpm --filter temple-era-web db:migration:dump:data",
    "db:migration:dump:full": "pnpm --filter temple-era-web db:migration:dump:full",
    "db:migration:preflight": "pnpm --filter temple-era-web db:migration:preflight",
    "db:migration:restore": "pnpm --filter temple-era-web db:migration:restore",
    "dev:doppler": "pnpm --filter temple-era-web dev:doppler"
  },
  "devDependencies": {
    "lefthook": "^2.1.10",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "turbo": "^2.10.8"
  },
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
