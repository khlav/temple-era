{
  "name": "@temple-era/wcl",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Warcraft Logs URL and report-ID parsing shared by apps/web and apps/bot",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt src/"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^5.5.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0"
  }
}
