{
  "name": "@temple-era/softres-blocks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Pure SoftRes Discord embed and weekly admin-token block logic shared by apps/web and apps/bot",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepare": "tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "format": "oxfmt --check src/",
    "format:fix": "oxfmt src/"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  }
}
